# Copy to .env and fill in. .env is gitignored; this file is not.
#
# WRITE IT AS UTF-8. `echo "KEY=..." > .env` in Windows PowerShell 5.1 produces
# UTF-16 LE with a BOM, and dbt's CLI calls python-dotenv at import time, which
# reads UTF-8 only -- so every dbt command dies with a UnicodeDecodeError whose
# traceback names dotenv and never mentions your .env file.
#
# dbt reads this file automatically (find_dotenv from the working directory), so
# anything set here reaches transform/profiles.yml without exporting it by hand.

# ---------------------------------------------------------------------------
# BigQuery. REQUIRED for any --target bigquery command.
# ---------------------------------------------------------------------------
# profiles.yml deliberately has NO default for this. It used to default to an
# empty string, which BigQuery answers with "Database Error: Request couldn't be
# served." -- a message that names nothing and reads like a broken adapter. An
# absent value now fails as an absent value.
#
# Note that `bigquery.Client()` in Python does NOT need this: it falls back to
# the project baked into your Application Default Credentials. That asymmetry is
# what makes the failure confusing -- ad-hoc scripts keep working while dbt does
# not, on the same machine, with the same credentials.
GCP_PROJECT_ID=your-gcp-project-id

# Optional; these have working defaults in profiles.yml.
# BQ_DATASET=olist
# BQ_RAW_DATASET=olist_raw
# BQ_LOCATION=US

# ---------------------------------------------------------------------------
# Gemini. Needed for enrichment, embeddings and the NL->SQL agent.
# A clone that only wants to BUILD does not need this: the labels and the
# embeddings are committed, and `make enrich-restore` loads them for $0.00.
# ---------------------------------------------------------------------------
GEMINI_API_KEY=your-gemini-api-key

# ---------------------------------------------------------------------------
# Public demo ceilings. Every one is optional and every one has a documented
# default in analytics/settings.py. Set them to raise a ceiling after topping up
# the key, without editing code. A value that will not parse is an ERROR rather
# than a silent fall back to the default.
# ---------------------------------------------------------------------------
# OLIST_DEMO_LIFETIME_USD=2.00
# OLIST_DEMO_DAY_USD=0.05
# OLIST_DEMO_SESSION_USD=0.01
# OLIST_DEMO_SESSION_CALLS=10
# OLIST_DEMO_RESERVE_USD=0.25
# OLIST_BQ_MAX_BYTES_PER_QUERY=1073741824
# OLIST_BQ_MAX_BYTES_PER_SESSION=5368709120
# OLIST_BQ_MAX_QUERIES_PER_SESSION=11
