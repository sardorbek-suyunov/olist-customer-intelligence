%% Olist Customer Intelligence -- architecture.

%% THIS FILE IS THE SOURCE OF TRUTH FOR THE DIAGRAM.

%% docs/img/architecture.svg is RENDERED from it by `make diagram`. If the two
%% disagree, this one is right and the image is stale -- change this file first.

%% Every dbt model and dataset named below is asserted to exist in the dbt
%% manifest by analytics/tests/test_architecture_diagram.py, which runs in CI.
%% A model renamed or dropped fails the build rather than leaving a picture
%% quietly describing a pipeline that no longer exists. That check, and the fact
%% that the image is generated from this file rather than drawn beside it, are
%% the only reasons an image artifact is allowed in this repository.

%% Detail belongs in the README, not in a node label. A diagram that tries to
%% state every figure becomes a tall column of paragraphs nobody reads, which is
%% what the first version of this was.

%% NOTE: a line that is exactly "%%" breaks mermaid's comment stripper -- it eats
%% the newline and glues the next line onto the marker. Leave blank lines blank.

flowchart TB

  CSV["archive/*.csv<br/>Kaggle extract · 9 files<br/>1,550,851 rows"]

  subgraph AF["Airflow 3 · monthly backfill + daily incremental"]
    direction LR
    REPLAY["replay_slice<br/>ingestion/replay.py"]
    SLICES[("data/slices/<br/>56 windows · Parquet<br/>not committed")]
    LOAD["load_to_warehouse<br/>ingestion/load.py"]
    VERIFY["verify_slice_complete<br/>COUNT(*) from the table,<br/>not the job's output_rows"]
    DBTRUN["dbt_build"]

    REPLAY --> SLICES --> LOAD --> VERIFY --> DBTRUN
  end

  subgraph WH["Warehouse · one dbt codebase, two adapters"]
    direction LR
    RAW[("raw · 11 sources<br/>olist_raw")]
    STG["staging · 9 views<br/>stg_customers · stg_orders<br/>stg_order_items · stg_order_payments<br/>stg_order_reviews · stg_products<br/>stg_sellers · stg_geolocation<br/>stg_review_enrichment"]
    INT["intermediate · 3 ephemeral<br/>int_customer_address_versions<br/>int_customer_rfm<br/>int_order_review_aspects"]
    MARTS["marts · 5 models<br/>dim_customers SCD2<br/>dim_products · dim_sellers<br/>fct_orders incremental, as-of join<br/>fct_segment_aspect RFM × aspect"]

    RAW --> STG --> INT --> MARTS
  end

  subgraph ENR["Gemini enrichment · offline, committed"]
    direction LR
    LABEL["enrich.py<br/>flash-lite · prompt v1<br/>35,616 texts · 16 aspects"]
    LABELS[("enrichment/data/*.parquet<br/>committed — re-run costs $0")]
    EMBED["embed.py<br/>gemini-embedding-2 · 1536-d"]
    VEC[("embeddings · 35,616<br/>VECTOR_SEARCH, brute force<br/>42.5% of the query ceiling")]

    LABEL --> LABELS --> EMBED --> VEC
  end

  subgraph SERVE["Serving"]
    direction LR
    SNAP["export_snapshot.py"]
    PARQ[("dashboard/data/*.parquet<br/>committed, ~15 MB")]
    APP["Streamlit<br/>dashboard/app.py"]
    AGENT["NL→SQL agent<br/>analytics/nl2sql.py<br/>prompt v2 · 23/25"]
    BUDGET["gemini_budget<br/>priced before the call"]
    GUARD["sql_guard<br/>sqlglot · single SELECT<br/>injects the LIMIT"]
    SAFE["bq_safety<br/>dry run · both ceilings<br/>maximum_bytes_billed"]
    TRANS["snapshot_runner<br/>transpiles BigQuery SQL<br/>→ DuckDB, on the AST"]
    ADC["ADC · runs as project OWNER<br/>no scoped service account exists"]

    APP --> AGENT --> BUDGET --> GUARD
    GUARD --> SAFE --> ADC
    GUARD --> TRANS
  end

  CSV --> REPLAY
  LOAD --> RAW
  DBTRUN -.->|builds| RAW
  LABELS -->|"source olist_enrichment"| STG
  MARTS --> SNAP --> PARQ --> TRANS
  CSV --> LABEL
  MARTS --> SAFE
  VEC --> SAFE

  classDef bq      fill:#12304d,stroke:#4a9eff,stroke-width:2px,color:#e8f1fb
  classDef duck    fill:#43340c,stroke:#ffc857,stroke-width:2px,color:#fff8e7
  classDef both    fill:#153322,stroke:#4ade80,stroke-width:2px,color:#e9fbf0
  classDef neutral fill:#26262e,stroke:#8b8b9a,stroke-width:1px,color:#ececf2

  class RAW,STG,INT,MARTS both
  class VEC,SAFE,ADC bq
  class PARQ,TRANS duck
  class CSV,REPLAY,SLICES,LOAD,VERIFY,DBTRUN,LABEL,LABELS,EMBED,SNAP,APP,AGENT,GUARD,BUDGET neutral

  subgraph KEY["Which engine runs what"]
    direction LR
    K1["Both engines<br/>identical dbt models"]
    K2["BigQuery only<br/>bytes and vectors"]
    K3["DuckDB only<br/>the public demo"]
  end

  class K1 both
  class K2 bq
  class K3 duck
