          "description": ""
        },
        {
          "name": "order_purchase_timestamp",
          "description": ""
        },
        {
          "name": "order_approved_at",
          "description": ""
        },
        {
          "name": "order_delivered_customer_date",
          "description": ""
        },
        {
          "name": "order_estimated_delivery_date",
          "description": ""
        },
        {
          "name": "item_count",
          "description": ""
        },
        {
          "name": "seller_count",
          "description": ""
        },
        {
          "name": "product_count",
          "description": ""
        },
        {
          "name": "items_value",
          "description": ""
