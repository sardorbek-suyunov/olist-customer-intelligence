    "fct_segment_aspect": {
      "description": "RFM segment x review aspect, one row per pair, complete grid. Carries review-text coverage per segment as a column because every aspect rate here is computed over the ~41% of orders that have review text, and that share differs by segment. Frequency is deliberately NOT scored into quintiles: 96.88% of customers have exactly one order, so NTILE(5) over that column cuts ties into arbitrary blocks that look exactly like real scores. Segmentation is on R and M; frequency travels as a count and a flag. Every row is stamped with the prompt version and model that produced the labels. The marts ship v1; prompt v2 measured better and is not applied. See docs/DECISIONS.md 5b.",
      "columns": [
        {
          "name": "rfm_segment",
          "description": ""
        },
        {
          "name": "aspect",
          "description": ""
        },
        {
          "name": "aspect_group",
          "description": ""
        },
        {
          "name": "is_delivery_complaint",
          "description": ""
        },
        {
          "name": "label_prompt_version",
          "description": "The prompt version the shipped labels came from. One value across the mart."
        },
        {
          "name": "label_model",
          "description": ""
        },
        {
          "name": "customers_in_segment",
          "description": ""
        },
        {
          "name": "orders_in_segment",
          "description": ""
        },
        {
          "name": "orders_with_review_text",
          "description": ""
        },
        {
          "name": "review_text_coverage_pct",
          "description": "Share of the segment's orders carrying review text. The denominator caveat."
        },
        {
          "name": "orders_mentioning_aspect",
          "description": ""
        },
        {
          "name": "reviews_mentioning_aspect",
          "description": ""
        },
        {
          "name": "aspect_rate_of_reviewed",
          "description": ""
        },
        {
          "name": "aspect_rate_of_all_orders",
          "description": ""
        }
      ]
    }
  }
